# =====================================================================
# FastDL Development Environment (.env.dev)
# Copy to .env.dev via `make setup`
# =====================================================================
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HMAC_SECRET=dev-only-change-in-prod-local-secret-key-32bytes

# Redis & Worker
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=3
PER_PLATFORM_CONCURRENCY=2
RESOLVE_CACHE_TTL_SECONDS=600
FILE_TTL_SECONDS=1800

# Relaxed rate limits for local dev
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RESOLVE_PER_MINUTE=120
RATE_LIMIT_JOBS_PER_MINUTE=60
MAX_CONCURRENT_JOBS_PER_IP=6

# Limits & Speed
MIN_FREE_DISK_BYTES=536870912
MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=2147483648
YTDLP_CONCURRENT_FRAGMENTS=16
ENABLE_ARIA2C=true

# Anti-Block L1-L7 (direct egress locally)
YTDLP_AUTO_UPDATE=false
YTDLP_CHANNEL=stable
YTDLP_PINNED_VERSION=
IMPERSONATE_ENABLED=true
IMPERSONATE_TARGET=chrome
POT_PROVIDER_ENABLED=true
POT_PROVIDER_URL=http://pot-provider:4416
YOUTUBE_PLAYER_CLIENTS=android_vr,mweb,tv_simply,web_safari,ios,web_embedded,default

# Optional proxies (empty = direct home/dev IP)
PROXY_URLS=
PROXY_URLS_YOUTUBE=
PROXY_URLS_X=
PROXY_URLS_INSTAGRAM=
PROXY_URLS_FACEBOOK=
PROXY_STRATEGY=sticky

# Optional Turnstile (disabled in dev)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Frontend internal proxy target
API_INTERNAL_URL=http://api:8000

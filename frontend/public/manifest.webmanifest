{
  "name": "FastDL — Public Video Downloader",
  "short_name": "FastDL",
  "description": "Fast, privacy-first Neo-Brutalist downloader for public videos from YouTube, X, Instagram, and Facebook.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#EAE8E1",
  "theme_color": "#B8FF01",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}

# =====================================================================
# FastDL Production Environment (.env.prod)
# NEVER commit .env.prod to git! Copy from this template via `make setup`
# and replace HMAC_SECRET with `openssl rand -hex 32`.
# =====================================================================
APP_ENV=production
LOG_LEVEL=INFO
DOMAIN=fastdownloading.solaymanbuilds.com
LETSENCRYPT_EMAIL=elmouden00den@gmail.com
CORS_ORIGINS=https://fastdownloading.solaymanbuilds.com
HMAC_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Image tag (used by deploy & rollback)
IMAGE_TAG=latest
PREV_IMAGE_TAG=latest

# Localhost port for bundled Nginx (proxied by Host Nginx on 80/443)
NGINX_HTTP_PORT=8088
EXTERNAL_PROXY_NETWORK=proxy_net

# Redis & Worker
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=4
PER_PLATFORM_CONCURRENCY=2
RESOLVE_CACHE_TTL_SECONDS=720
FILE_TTL_SECONDS=1800
DOWNLOAD_TOKEN_TTL_SECONDS=900

# Security & Rate Limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RESOLVE_PER_MINUTE=30
RATE_LIMIT_JOBS_PER_MINUTE=15
MAX_CONCURRENT_JOBS_PER_IP=3
PLATFORM_RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=true
MAX_REQUEST_BODY_BYTES=65536

# Disk & Media Limits
MIN_FREE_DISK_BYTES=1073741824
MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=2147483648
YTDLP_CONCURRENT_FRAGMENTS=12
ENABLE_ARIA2C=false

# Anti-Block L1: Auto-update yt-dlp with rollback
YTDLP_AUTO_UPDATE=true
YTDLP_CHANNEL=stable
YTDLP_PINNED_VERSION=

# Anti-Block L2: Browser TLS/HTTP2 impersonation
IMPERSONATE_ENABLED=true
IMPERSONATE_TARGET=chrome

# Anti-Block L3: YouTube PO Token sidecar & player client fallback
POT_PROVIDER_ENABLED=true
POT_PROVIDER_URL=http://pot-provider:4416
YOUTUBE_PLAYER_CLIENTS=default,mweb,android_vr,web_safari,ios,web_embedded,tv

# Anti-Block L5: Egress Proxies (comma-separated http/https/socks5)
# For Cloudflare WARP profile (--profile warp), set: socks5h://warp:1080
PROXY_URLS=
PROXY_URLS_YOUTUBE=
PROXY_URLS_X=
PROXY_URLS_INSTAGRAM=
PROXY_URLS_FACEBOOK=
PROXY_STRATEGY=sticky
PROXY_COOLDOWN_SECONDS=300
PROXY_MAX_FAILURES=3

# Anti-Block L6: Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# Optional Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Observability (L8)
SENTRY_DSN=
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=change_me_in_prod
